---
import { getCollection } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { readingTime } from "../../utils/readingTime";

const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const postsWithMeta = allPosts.map((post) => ({
  post,
  minutes: readingTime(post.body).minutes,
}));

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

const blogUrl = new URL("/blog/", Astro.site).href;
const blogDescription =
  "Practical, no-fluff guides on planning trips, packing smart, budgeting, and keeping travel memories. Written by Robert Jensen, developer of Travel Stories.";

const blogNode = {
  "@type": "Blog",
  "@id": `${blogUrl}#blog`,
  name: "Travel Stories Blog",
  description: blogDescription,
  url: blogUrl,
  inLanguage: "en",
  publisher: { "@id": "https://www.12f.dk/#organization" },
  blogPost: allPosts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.publishDate.toISOString(),
    url: new URL(`/blog/${post.slug}/`, Astro.site).href,
    author: { "@id": "https://www.12f.dk/#robert" },
  })),
};

const postListNode = {
  "@type": "ItemList",
  "@id": `${blogUrl}#posts`,
  name: "Travel Stories blog posts",
  numberOfItems: allPosts.length,
  itemListOrder: "https://schema.org/ItemListOrderDescending",
  itemListElement: allPosts.map((post, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: post.data.title,
    url: new URL(`/blog/${post.slug}/`, Astro.site).href,
  })),
};
---

<BlogLayout
  title="Travel Stories Blog — Planning, Packing & Budgets"
  description={blogDescription}
  canonicalPath="/blog/"
  extraGraphNodes={[blogNode, postListNode]}
  hideAppBanner={true}
>
  <main id="main" class="mx-auto max-w-[1440px] px-[var(--gutter)] pb-8 pt-[clamp(56px,8vw,128px)]">
    <header class="max-w-[64rem]" data-reveal>
      <h1 class="text-display font-light">
        Travel planning guides
      </h1>
      <p class="mt-8 max-w-[40ch] text-lead text-ink">
        Plan better trips. Keep better memories. Practical guides on planning,
        packing and budgeting your trips, and on holding onto them afterwards.
      </p>
      <p class="mt-5 text-body text-muted">
        Looking for a checklist rather than an article? The{" "}
        <a href="/packing-list/" class="ts-link text-ink">packing list generator</a>{" "}
        builds one for your trip: free, no sign-up, printable.
      </p>
    </header>

    {
      postsWithMeta.length === 0 ? (
        <p class="mt-16 text-body text-muted">No posts yet.</p>
      ) : (
        <ul class="mt-[clamp(64px,8vw,128px)] flex list-none flex-col gap-[clamp(56px,7vw,112px)] p-0">
          {postsWithMeta.map(({ post, minutes }, index) => (
            <li class="m-0 p-0" data-reveal>
              <a
                href={`/blog/${post.slug}/`}
                class="group grid items-center gap-6 md:grid-cols-12 md:gap-10"
              >
                {post.data.cover && (
                  <div class={`overflow-hidden rounded-ui bg-surface ${index === 0 ? "md:col-span-7" : "md:col-span-5"}`}>
                    <img
                      src={post.data.cover}
                      alt={post.data.coverAlt ?? ""}
                      width={640}
                      height={360}
                      loading={index < 2 ? "eager" : "lazy"}
                      decoding="async"
                      class="aspect-[16/9] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                    />
                  </div>
                )}
                <div class={index === 0 ? "md:col-span-5" : "md:col-span-6 md:col-start-7"}>
                  <h2 class="text-lead text-ink">
                    <span class="ts-link">{post.data.title}</span>
                  </h2>
                  <p class="mt-3 max-w-[52ch] text-body text-muted">
                    {post.data.description}
                  </p>
                  <p class="mt-4 text-small text-muted tabular">
                    <time datetime={post.data.publishDate.toISOString()}>
                      {formatDate(post.data.publishDate)}
                    </time>
                    {" · "}{minutes} min
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</BlogLayout>
