---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  heading?: string;
}

const { items, heading = "Frequently asked questions" } = Astro.props;

// No JSON-LD here: the page folds an FAQPage node into its single
// consolidated @graph (see BlogLayout extraGraphNodes, #24).
---

{
  items.length > 0 && (
    <section class="not-prose my-16 max-w-[46rem]" aria-labelledby="post-faq">
      <h2 id="post-faq" class="mb-8 text-head font-light">
        {heading}
      </h2>
      <div class="flex flex-col gap-6" data-reveal-each>
        {items.map((item) => (
          <p class="faq-answer text-body text-muted">
            <strong class="font-medium text-ink">{item.question}</strong> {item.answer}
          </p>
        ))}
      </div>
    </section>
  )
}
