---
import { withCampaignInHtml, blogCampaignToken } from "../../utils/appStoreCampaign";

interface Props {
  items: string[];
  /** Post slug. App Store links in the bullets get `ct=blog-<slug>`. */
  slug: string;
}

const { items: rawItems, slug } = Astro.props;
// TL;DR entries are authored as HTML in frontmatter and several link to the
// App Store, so they need attributing too (#62).
const items = rawItems.map((item) => withCampaignInHtml(item, blogCampaignToken(slug)));
---

{
  items.length > 0 && (
    <aside
      class="not-prose my-8 rounded-2xl border-l-4 border-primary bg-base-200 p-5 sm:p-6"
      data-speakable
      aria-label="Article summary"
    >
      <p class="mb-3 text-sm font-bold uppercase tracking-wide text-primary">
        TL;DR
      </p>
      <ul class="space-y-2 text-base-content">
        {items.map((item) => (
          <li class="flex gap-2">
            <span class="text-primary" aria-hidden="true">
              ▸
            </span>
            <span set:html={item} />
          </li>
        ))}
      </ul>
    </aside>
  )
}
