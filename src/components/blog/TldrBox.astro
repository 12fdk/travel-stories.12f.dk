---
import { withCampaignInHtml } from "../../utils/appStoreCampaign";

interface Props {
  items: string[];
}

const { items: rawItems } = Astro.props;
// TL;DR entries are authored as HTML in frontmatter and several link to the
// App Store, so they need attributing too (#52).
const items = rawItems.map((item) => withCampaignInHtml(item, "blog"));
---

{
  items.length > 0 && (
    <aside
      data-reveal-self
      class="not-prose my-10 rounded-ui bg-surface p-6 sm:p-8"
      data-speakable
      aria-label="Article summary"
    >
      <p class="mb-3 text-body font-medium text-ink">In short</p>
      <ul class="m-0 flex list-disc flex-col gap-2 pl-5 text-body text-ink marker:text-muted">
        {items.map((item) => (
          <li><span set:html={item} /></li>
        ))}
      </ul>
    </aside>
  )
}
