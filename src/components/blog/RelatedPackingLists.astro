---
import type { CuratedPage } from "../../data/packingList/pages";

interface Props {
  pages: CuratedPage[];
  heading?: string;
}

/**
 * The path from a post into /packing-list/ (#65).
 *
 * Deliberately per-post rather than sitewide: an identical block on every
 * article is boilerplate, and boilerplate links get discounted. Each post
 * names the two or three lists that genuinely follow from what it just said.
 */
const { pages, heading = "Ready-made packing lists for this" } = Astro.props;
---

{
  pages.length > 0 && (
    <section class="not-prose my-16" aria-labelledby="related-packing-lists">
      <h2 id="related-packing-lists" class="text-lead font-medium">
        {heading}
      </h2>
      <p class="mt-2 max-w-2xl text-body text-muted">
        Free, no sign-up: tick items off in the browser, print it, or adjust it
        to your own trip.
      </p>
      <ul class="mt-6 flex list-none flex-col gap-4 p-0" data-reveal>
        {pages.map((page) => (
          <li class="m-0">
            <a
              href={`/packing-list/${page.slug}/`}
              data-umami-event="blog-to-packing-list"
              data-umami-event-list={page.slug}
              class="group block"
            >
              <span class="ts-link text-body text-ink">{page.h1}</span>
              <span class="mt-1 block text-small text-muted">{page.description}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-small text-muted">
        Or <a href="/packing-list/" class="ts-link text-ink">build one from scratch</a>{" "}
        with the packing list generator.
      </p>
    </section>
  )
}
