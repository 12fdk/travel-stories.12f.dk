---
interface Props {
  name?: string;
  bio?: string;
  avatarUrl?: string;
}

const {
  name = "Robert Jensen",
  bio = "Robert is the developer of Travel Stories. He built the app after one too many trips scattered across spreadsheets, notes apps, and screenshot folders — and wanted planning and the memories afterwards to live in one place.",
  avatarUrl = "/avatars/robert.webp",
} = Astro.props;
---

<aside data-reveal-self class="not-prose my-16 flex flex-col items-start gap-5 rounded-ui bg-surface p-7 sm:flex-row sm:items-center sm:p-9">
  <img
    src={avatarUrl}
    alt={`${name}, author`}
    width="72"
    height="72"
    loading="lazy"
    class="h-[72px] w-[72px] flex-shrink-0 rounded-full object-cover"
    onerror="this.style.display='none'"
  />
  <div>
    <p class="text-body text-ink">Written by {name}</p>
    <p class="mt-1 text-small text-muted">{bio}</p>
  </div>
</aside>
