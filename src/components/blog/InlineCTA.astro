---
import defaultTemplateConfig from "../../utils/config";
import { withCampaign, blogCampaignToken } from "../../utils/appStoreCampaign";

type Variant = "inline" | "callout";

interface Props {
  variant?: Variant;
  heading?: string;
  body?: string;
  buttonText?: string;
  trackingId?: string;
  appStoreLink?: string;
  /** Post slug. The button's `ct` is `blog-<slug>`, truncated to 40 characters. */
  slug: string;
}

const {
  variant = "callout",
  heading = "Plan the trip. Keep the story.",
  body = "Travel Stories keeps your itinerary, packing list, budget, and memories in one offline iPhone app — free on the App Store, no subscription.",
  buttonText = "Get Travel Stories — Free",
  trackingId = "blog-inline-cta",
  appStoreLink = defaultTemplateConfig.appStoreLink,
  slug,
} = Astro.props;

const ctaLink = withCampaign(appStoreLink, blogCampaignToken(slug));
---

{
  variant === "inline" ? (
    <p class="not-prose my-6">
      <a
        href={ctaLink}
        target="_blank"
        rel="noopener"
        data-umami-event={trackingId}
        class="ts-link font-medium text-ink"
      >
        {body}
      </a>
    </p>
  ) : (
    <aside
      data-reveal-self
      class="not-prose my-14 rounded-ui bg-field p-7 text-field-ink sm:p-10"
      data-cta-id={trackingId}
    >
      <h3 class="mb-3 text-lead">{heading}</h3>
      <p class="mb-7 max-w-[52ch] text-body text-field-muted">{body}</p>
      <a
        href={ctaLink}
        target="_blank"
        rel="noopener"
        data-umami-event={trackingId}
        class="ts-button"
      >
        {buttonText}
      </a>
    </aside>
  )
}
