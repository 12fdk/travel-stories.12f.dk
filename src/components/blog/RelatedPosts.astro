---
import type { CollectionEntry } from "astro:content";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <section class="not-prose mt-24" aria-labelledby="keep-reading">
      <h2 id="keep-reading" class="mb-8 text-head font-light">Keep reading</h2>
      <ul class="grid list-none gap-10 p-0 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
        {posts.map((post) => (
          <li class="m-0 p-0">
            <a href={`/blog/${post.slug}/`} class="group flex h-full flex-col">
              {post.data.cover && (
                <span class="block overflow-hidden rounded-ui bg-surface">
                  <img
                    src={post.data.cover}
                    alt={post.data.coverAlt ?? ""}
                    width={400}
                    height={225}
                    loading="lazy"
                    decoding="async"
                    class="aspect-[16/9] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                  />
                </span>
              )}
              <span class="mt-4 block text-body text-ink">
                <span class="ts-link">{post.data.title}</span>
              </span>
              <span class="mt-2 block text-small text-muted">{post.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
